.pio
*.bgcode
.DS_Store
__pycache__/

# Both name absolute paths on this machine and pin the toolchain version:
# compile_commands.json is regenerated by `pio run -t compiledb`, and .clangd
# is written by hand from `riscv32-esp-elf-g++ -E -x c++ -v /dev/null`.
compile_commands.json
.clangd

# clangd's index, written next to compile_commands.json.
.cache/

# Per-machine Claude Code permissions. These carry absolute paths from whichever
# machine wrote them, and this repo is public. The shared settings.json, if one
# is ever added, is deliberately not matched.
**/.claude/settings.local.json
